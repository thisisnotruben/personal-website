---
interface Props {
    float: string;
    entry: {
        key: string;
        value: {
            text: string;
            isLink: boolean;
            link: string;
        };
    }[];
}

const { entry, float } = Astro.props;
---

<table style=`float: ${float}`>
    <tbody>
        {entry.map((e) => (
            <tr>
                <td>{e.key}</td>
                <td>
                    {e.value.isLink ? (
                        <a href={e.value.link} target="_blank">
                            {e.value.text}
                        </a>
                    ) : (
                        e.value.text
                    )}
                </td>
            </tr>
        ))}
    </tbody>
</table>
