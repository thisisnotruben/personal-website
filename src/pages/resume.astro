---
import BaseLayout from "@layouts/BaseLayout.astro";
import ResumeCell from "@src/components/ResumeCell.astro";
import { getConfig } from "@src/lib/tina/data";

const config = (await getConfig()).data?.config ?? null;

const jobs = [
    {
        company: "BlueCross BlueShield",
        location: "Columbia, SC",
        positions: [
            {
                name: "Software II",
                duration: "July 2026 - Present",
                summary:
                    "Operations based team that hosts a multitude of platforms from API Connect, API Datapower & Kong Gateway that interacts/modernizes with legacy health care infrastructure through Enterprise Integrations Patterns (EIPs).",
                points: [
                    "Assist internal lateral team applications that need to query sensitive health care information.",
                    "Assist in the documentation of API's to modern standards such Open API through swagger.",
                    "Analyze faults in systems through aggregated logs in Mongo database and trace to source and resolve.",
                    "Be part of the efforts to help in AI integrate in our gateways to help modernize possible solutions of past legacy solutions."
                ],
            },
        ],
    },
    {
        company: "General Motors",
        location: "Austin, TX",
        positions: [
            {
                name: "Full-Stack Software Developer",
                duration: "August 2023 - January 2025",
                summary: "Development team tasked with providing uniform reusable UI components with common back-end functionality to entire company for commonly performed tasks.",
                points: [
                    "Hands on development/debugging of multiple applications sticking to agile methodologies.",
                    "Development and planning of applications utilizing Java Spring-boot and/or Angular Js.",
                    "Develop API's, automating firewall and load-balancer service requests within company.",
                    "Performance enhance components to provide more stable and acceptable usage according to SLA.",
                    "Tasked with migrating custom AngularJs/Java Spring-boot application of a ticketing system to ServiceNow. Successfully released the first iteration of the ServiceNow Application.",
                ],
            },
            {
                name: "Technical Support Engineer",
                duration: "June 2021 - October 2024",
                summary: "Administrative/Operations based team in which we provided IBM APIC as PaaS to clients inside GM. Duties ranged from keeping the PaaS operational/upgraded to maintain SLA, to providing on-call support to our clients 24/7 to assist with deployments/critical-issues.",
                points: [
                    "Daily hands-on in API management in regards to consultations/development in IBM APIC/Azure APIM.",
                    "Manage PKI by creating/installing X.509 certificates on our distributed servers.",
                    "Administer Websphere Liberty & OpenID servers.",
                    "Architecturally plan solutions of our migration efforts as a result of environment versioning.",
                    "Administrate our PaaS on Red Hat Openshift environment (Kubernetes).",
                    "Support applications after-hours from mundane to business critical issues.",
                ],
            },
        ],
    },
];

const univeristy = ["B.S. Computer Science", "GPA: 3.88", "2019 - 2021"];
const college = ["A.S. of Arts, Business & Sciences", "2016 - 2019"];

const languages = [
    "Python",
    "TypeScript",
    "SQL",
    "Bash",
    "Java",
    "GDScript",
];
const platforms = [
    "IBM API Connect",
    "IBM Datapower",
    "IBM Websphere Liberty",
    "Red Hat Openshift",
    "Azure APIM",
    "ServiceNow",
    "PostgreSQL",
    "MongoDB",
    "Godot Game Engine",
];
const frameworks = [
    "Java Spring-boot",
    "Angular Js",
    "Vue Js",
    "Astro",
    "Tailwind Css",
];
const technologies = [
    "OpenAPI",
    "OpenAPI CodeGen",
    "Docker",
    "Kubernetes",
    "Apache Lucene",
    "Apache Solr",
];
// const methodologies = ["Agile", "Scrum"];
const certificates = ["AWS Certified Cloud Practitioner (CLF-C02)"];
---

<BaseLayout config={config} pageTitle="Resume">
    <a
        id="resume-download"
        slot="page-title-right"
        href="/resume.pdf"
        download="ruben_alvarez_reyes_resume.pdf"
    >
        <img src="/download.svg" /> Download
    </a>

    <article id="resume">
        <h2>Professional Experiance</h2>
        {jobs.map((job) => (
            <section>
                <div class="resume-job-header transition-slide-left">
                    <h3>{job.company}</h3>
                    <p class="resume-job-location">{job.location}</p>
                </div>

                {job.positions.map((position) => (
                    <div class="resume-job-header transition-slide-left">
                        <h4>{position.name}</h4>
                        <p>{position.duration}</p>
                    </div>

                    <p class="transition-slide-right">{position.summary}</p>

                    <ul class="transition-slide-right">
                        {position.points.map((point) => (
                            <li>{point}</li>
                        ))}
                    </ul>

                ))}
            </section>
        ))}

        <h2>Education</h2>
        <section class="grid-resume-section transition-slide-left">
            <ResumeCell
                header="University of Arizona"
                ,
                contentList={univeristy}
            />
            <ResumeCell
                header="Arizona Western College"
                ,
                contentList={college}
            />
        </section>

        <h2>Skills</h2>
        <section class="grid-resume-section transition-slide-left">
            <ResumeCell header="Languages" , contentList={languages} />
            <ResumeCell header="Platforms" , contentList={platforms} />
            <ResumeCell header="Frameworks" , contentList={frameworks} />
            <ResumeCell header="Technologies" , contentList={technologies} />
            <!-- <ResumeCell header="Methodologies" , contentList={methodologies} /> -->
            <ResumeCell header="Certificates" , contentList={certificates} />
        </section>
    </article>
</BaseLayout>
