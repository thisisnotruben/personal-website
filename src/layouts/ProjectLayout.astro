---
import { getConfig, getProject } from "@src/lib/tina/data";
import { islands } from "@src/lib/tina/islands";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import BaseLayout from "./BaseLayout.astro";
import ProjectLayoutProxy from "./ProjectLayoutProxy.astro";

interface Props {
    slug: string;
}

const { slug } = Astro.props;
const project = await getProject(slug);
const data = project.data?.projects;
const config = (await getConfig()).data?.config ?? null;
---

<BaseLayout config={config} pageTitle={data.title}>
    <div slot="breadcrumbs" aria-label="Breadcrumb" class="breadcrumb">
        <ol>
            <li>
                <a href="/projects">Projects</a>
            </li>
            <li>
                <span aria-current="page">{data.title}</span>
            </li>
        </ol>
    </div>

    <TinaIsland
        name="projects"
        wrapper={islands.projects.wrapper}
        params={{ slug }}
        primary
    >
        <ProjectLayoutProxy data={data} />
    </TinaIsland>
</BaseLayout>
