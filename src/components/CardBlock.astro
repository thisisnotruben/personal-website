---
import {
    getOriginalSize,
    getOriginalFromId,
    getThumbnailFromId,
} from "@src/scripts/immich";

interface Props {
    id: string;
    thumbnail: boolean;
    float: string;
    caption: string;
}

const { id, thumbnail, float, caption } = Astro.props;
const { width, height } = await getOriginalSize(id);

const src = getOriginalFromId(id);
---

<div class="card transition-slide-right" style=`float: ${float}`>
    <figure class="gallery">
        <a
            href={src}
            data-pswp-width={width}
            data-pswp-height={height}
            target="_blank"
        >
            <img src={thumbnail ? getThumbnailFromId(id) : src} />
        </a>
        <figcaption>{caption}</figcaption>
    </figure>
</div>
