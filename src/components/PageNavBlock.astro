---
import { listProjects } from "@src/lib/tina/data";
import type { PageNavType } from "@src/scripts/types";
import ProjectEntry from "./ProjectEntry.astro";

interface Props {
    collectionRef: string;
}

const { collectionRef } = Astro.props;

var entries: PageNavType[] = [];

switch (collectionRef) {
    case "projects":
        (await listProjects()).forEach((p) =>
            entries.push({
                href: `${collectionRef}/${p._sys.filename}`,
                title: p.title,
                cover: p.cover ?? "",
                description: p.description ?? "",
            }),
        );
        break;
    // case "blog":
    //     (await listBlogs()).forEach((p) =>
    //         filenameMap.set(p._sys.filename, { title: p.title }),
    //     );
    //     break;
}
---

<ul>
    {entries.map((e) => (
        <li>
            <a href={e.href}>{e.title}</a>
        </li>
    ))}
</ul>

<div class="project-entries">
    {entries.map((e) => (
        <ProjectEntry payload={e} />
    ))}
</div>
