---
interface Props {
    entry: {
        key: string;
        value: {
            text: string;
            isLink: boolean;
            link: string;
        };
    }[];
}

const { entry } = Astro.props;
---

<table>
    <tbody>
        {entry.map((e) => (
            <tr>
                <td>{e.key}</td>
                <td>
                    {e.value.isLink ? (
                        <a href={e.value.link}>{e.value.text}</a>
                    ) : (
                        e.value.text
                    )}
                </td>
            </tr>
        ))}
    </tbody>
</table>
